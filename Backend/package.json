{
  "name": "backend",
  "version": "1.0.0",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "predev": "npm run db:generate",
    "dev": "node --watch src/server.js",
    "prestart": "npm run db:generate",
    "start": "node src/server.js",
    "format": "prettier --write \"src/**/*.js\"",
    "db:generate": "prisma generate --schema src/shared/database/prisma/schema.prisma",
    "db:push": "prisma db push --schema src/shared/database/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema src/shared/database/prisma/schema.prisma",
    "db:seed": "node src/shared/database/seed/seed.js",
    "db:seed-departments": "node scripts/seed-departments.js",
    "db:seed-crm": "node scripts/seed-crm.js",
    "db:seed-access": "node scripts/seed-access-control.js",
    "db:seed-products": "node scripts/import-products.js",
    "db:provision": "node scripts/provision-mysql.js",
    "setup": "npm run db:provision && npm run db:generate && npm run db:push && npm run db:seed",
    "test": "node --test"
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "axios": "^1.19.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "digest-fetch": "^3.1.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "mysql2": "^3.23.3",
    "socket.io": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "prisma": "^6.19.3"
  }
}
