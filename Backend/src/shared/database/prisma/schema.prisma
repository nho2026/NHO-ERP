generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                String               @id @default(cuid())
  username          String               @unique
  email             String               @unique
  name              String
  passwordHash      String
  pinHash           String?
  pinLookup         String?              @unique
  department        String?
  status            String               @default("active")
  roles             UserRole[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  employee          Employee?
  createdTasks      Task[]               @relation("TaskCreator")
  reviewedTasks     Task[]               @relation("TaskReviewer")
  taskComments      TaskComment[]
  recordedTaskTime  TaskTimeEntry[]
  notifications     Notification[]
  submittedIdeas    EmployeeIdea[]
  sentWarnings      Warning[]            @relation("WarningSender")
  warningRecipients WarningRecipient[]
  createdMeetings   Meeting[]            @relation("MeetingCreator")
  meetingAttendance MeetingParticipant[]
  createdTargets     EmployeeTarget[]     @relation("TargetCreator")
}

model AttendanceDevice {
  id                  String             @id @default(cuid())
  name                String
  model               String             @default("DS-K1T342MFWX-E1")
  ipAddress           String
  port                Int                @default(80)
  username            String
  password            String
  serialNumber        String?
  status              String             @default("offline")
  lastSeenAt          DateTime?
  eventsClearedAt     DateTime?
  workingDaysPerMonth Int                @default(22)
  checkInTime         String             @default("09:00")
  checkOutTime        String             @default("17:00")
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  people              AttendancePerson[]
  events              AttendanceEvent[]

  @@unique([ipAddress, port])
}

model AttendancePerson {
  id             String            @id @default(cuid())
  deviceId       String
  employeeId     String?
  employeeNo     String
  name           String
  cardNo         String?
  hasFingerprint Boolean           @default(false)
  hasFace        Boolean           @default(false)
  hasPassword    Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  device         AttendanceDevice  @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  employee       Employee?         @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  events         AttendanceEvent[]

  @@unique([deviceId, employeeNo])
  @@index([employeeId])
}

model AttendanceEvent {
  id            String            @id @default(cuid())
  deviceId      String
  personId      String?
  employeeNo    String
  personName    String?
  eventType     String
  occurredAt    DateTime
  verification  String?
  deviceEventId String?
  createdAt     DateTime          @default(now())
  device        AttendanceDevice  @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  person        AttendancePerson? @relation(fields: [personId], references: [id], onDelete: SetNull)

  @@unique([deviceId, deviceEventId])
  @@index([occurredAt])
  @@index([employeeNo])
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  users       UserRole[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  name        String
  module      String
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permission")
}

model Position {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  status      String     @default("active")
  employees   Employee[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Employee {
  id                 String               @id @default(cuid())
  employeeCode       String               @unique
  userId             String?              @unique
  firstName          String
  lastName           String
  departmentId       String?
  positionId         String?
  hireDate           DateTime
  checkInTime        String               @default("09:00")
  checkOutTime       String               @default("17:00")
  status             String               @default("active")
  position           Position?            @relation(fields: [positionId], references: [id], onDelete: SetNull)
  department         Department?          @relation("DepartmentEmployees", fields: [departmentId], references: [id], onDelete: SetNull)
  managedDepartments Department[]         @relation("DepartmentManager")
  isTeamLeader       Boolean              @default(false)
  teamLeaderId       String?
  teamLeader         Employee?            @relation("TeamLeaderMembers", fields: [teamLeaderId], references: [id], onDelete: SetNull)
  teamMembers        Employee[]           @relation("TeamLeaderMembers")
  healthStaff        HealthStaff?
  user               User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  devicePeople       AttendancePerson[]
  salaries           EmployeeSalary[]
  attendance         EmployeeAttendance[]
  payrolls           Payroll[]
  salaryAdvances     SalaryAdvance[]
  taskAssignments    TaskAssignee[]
  taskTimeEntries    TaskTimeEntry[]
  targets            EmployeeTarget[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([departmentId])
  @@index([positionId])
  @@index([teamLeaderId])
}

model EmployeeTarget {
  id           String   @id @default(cuid())
  title        String
  description  String?  @db.Text
  metric       String
  unit         String
  targetValue  Float
  currentValue Float    @default(0)
  startDate    DateTime
  dueDate      DateTime
  status       String   @default("active")
  employeeId   String
  createdById  String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdBy    User     @relation("TargetCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([employeeId, status])
  @@index([createdById])
  @@index([dueDate])
}

model Task {
  id               String           @id @default(cuid())
  title            String
  description      String           @db.Text
  team             String?
  priority         String           @default("medium")
  status           String           @default("todo")
  startDate        DateTime?
  dueDate          DateTime?
  estimatedMinutes Int?
  completedAt      DateTime?
  reviewedAt       DateTime?
  reviewedById     String?
  reviewNote       String?          @db.Text
  createdById      String
  createdBy        User             @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  reviewedBy       User?            @relation("TaskReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  assignees        TaskAssignee[]
  attachments      TaskAttachment[]
  comments         TaskComment[]
  timeEntries      TaskTimeEntry[]
  notifications    Notification[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([status])
  @@index([team])
  @@index([dueDate])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  taskId    String?
  warningId String?
  meetingId String?
  crmLeadId String?
  type      String
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  task      Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  warning   Warning?  @relation(fields: [warningId], references: [id], onDelete: Cascade)
  meeting   Meeting?  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  crmLead   CrmLead?  @relation(fields: [crmLeadId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([taskId])
  @@index([warningId])
  @@index([meetingId])
  @@index([crmLeadId])
}

model EmployeeIdea {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String   @db.Text
  status      String   @default("submitted")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, createdAt])
}

model Warning {
  id            String             @id @default(cuid())
  senderId      String
  title         String
  message       String             @db.Text
  severity      String             @default("warning")
  sender        User               @relation("WarningSender", fields: [senderId], references: [id], onDelete: Restrict)
  recipients    WarningRecipient[]
  notifications Notification[]
  createdAt     DateTime           @default(now())

  @@index([createdAt])
}

model WarningRecipient {
  warningId String
  userId    String
  readAt    DateTime?
  warning   Warning   @relation(fields: [warningId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([warningId, userId])
  @@index([userId, readAt])
}

model TaskTimeEntry {
  id           String   @id @default(cuid())
  taskId       String
  employeeId   String
  recordedById String
  workDate     DateTime
  minutes      Int
  note         String?  @db.Text
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  recordedBy   User     @relation(fields: [recordedById], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())

  @@index([taskId])
  @@index([employeeId, workDate])
}

model TaskAssignee {
  taskId     String
  employeeId String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@id([taskId, employeeId])
  @@index([employeeId])
}

model TaskAttachment {
  id        String   @id @default(cuid())
  taskId    String
  fileName  String
  fileUrl   String
  mimeType  String
  fileSize  Int
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([taskId])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  body      String   @db.Text
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([taskId])
}

model Department {
  id              String           @id @default(cuid())
  code            String           @unique
  name            String           @unique
  description     String?
  managerId       String?
  status          String           @default("active")
  manager         Employee?        @relation("DepartmentManager", fields: [managerId], references: [id], onDelete: SetNull)
  employees       Employee[]       @relation("DepartmentEmployees")
  healthStaff     HealthStaff[]
  appointments    Appointment[]
  serviceAdvances ServiceAdvance[]
  meetings        Meeting[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([managerId])
}

model Meeting {
  id            String               @id @default(cuid())
  title         String
  roomCode      String               @unique
  departmentId  String
  creatorId     String
  status        String               @default("active")
  createdAt     DateTime             @default(now())
  endedAt       DateTime?
  department    Department           @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  creator       User                 @relation("MeetingCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  participants  MeetingParticipant[]
  notifications Notification[]

  @@index([departmentId, status])
  @@index([creatorId])
}

model MeetingParticipant {
  id        String    @id @default(cuid())
  meetingId String
  userId    String
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?
  meeting   Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([meetingId])
  @@index([userId])
}

model HealthStaff {
  id                   String        @id @default(cuid())
  employeeId           String        @unique
  departmentId         String?
  staffType            String
  specialization       String?
  licenseNumber        String?       @unique
  biography            String?       @db.Text
  publicBookingEnabled Boolean       @default(false)
  status               String        @default("active")
  employee             Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  department           Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  appointments         Appointment[]
  surgeryAppointments  SurgeryAppointment[]
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([departmentId])
  @@index([staffType])
}

model CrmLead {
  id          String   @id @default(cuid())
  name        String
  phone       String
  email       String?
  source      String?
  interest    String?
  notes       String?  @db.Text
  status      String   @default("new")
  convertedPatientId String?
  convertedPatient   Patient? @relation(fields: [convertedPatientId], references: [id], onDelete: SetNull)
  notifications      Notification[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, createdAt])
}

model Patient {
  id                  String               @id @default(cuid())
  patientCode         String               @unique
  firstName           String
  lastName            String
  phone               String
  email               String?
  dateOfBirth         DateTime?
  gender              String?
  address             String?
  bloodType           String?
  allergies           String?              @db.Text
  medicalNotes        String?              @db.Text
  status              String               @default("active")
  surgeryAppointments SurgeryAppointment[]
  payments            PatientPayment[]
  sourceLeads         CrmLead[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([phone])
  @@index([status])
}

model Surgery {
  id           String               @id @default(cuid())
  code         String               @unique
  name         String
  description  String?              @db.Text
  durationMinutes Int
  basePrice    Decimal              @db.Decimal(12, 2)
  status       String               @default("active")
  appointments SurgeryAppointment[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

model SurgeryAppointment {
  id              String           @id @default(cuid())
  patientId       String
  doctorId        String
  surgeryId       String
  scheduledAt     DateTime
  operatingRoom   String?
  status          String           @default("scheduled")
  preOpNotes      String?          @db.Text
  postOpNotes     String?          @db.Text
  patient         Patient          @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor          HealthStaff      @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  surgery         Surgery          @relation(fields: [surgeryId], references: [id], onDelete: Restrict)
  payments        PatientPayment[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([scheduledAt, status])
  @@index([patientId])
  @@index([doctorId])
}

model PatientPayment {
  id                   String              @id @default(cuid())
  patientId            String
  surgeryAppointmentId String?
  amount               Decimal             @db.Decimal(12, 2)
  paymentMethod        String
  reference            String?
  notes                String?             @db.Text
  paidAt               DateTime            @default(now())
  status               String              @default("paid")
  patient              Patient             @relation(fields: [patientId], references: [id], onDelete: Restrict)
  surgeryAppointment   SurgeryAppointment? @relation(fields: [surgeryAppointmentId], references: [id], onDelete: SetNull)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([patientId, paidAt])
  @@index([surgeryAppointmentId])
}

model Appointment {
  id              String           @id @default(cuid())
  patientName     String
  patientPhone    String
  patientEmail    String?
  doctorId        String
  departmentId    String
  scheduledAt     DateTime
  durationMinutes Int              @default(30)
  reason          String?
  notes           String?          @db.Text
  status          String           @default("pending")
  source          String           @default("admin")
  doctor          HealthStaff      @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  department      Department       @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  serviceAdvances ServiceAdvance[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([scheduledAt])
  @@index([doctorId, scheduledAt])
  @@index([departmentId])
}

model EmployeeSalary {
  id            String    @id @default(cuid())
  employeeId    String
  baseSalary    Float
  currencyId    String
  payType       String
  effectiveFrom DateTime
  effectiveTo   DateTime?
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payrolls      Payroll[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([employeeId])
}

model EmployeeAttendance {
  id                String    @id @default(cuid())
  employeeId        String
  attendanceDate    DateTime
  checkIn           DateTime?
  checkOut          DateTime?
  workedMinutes     Int       @default(0)
  lateMinutes       Int       @default(0)
  earlyLeaveMinutes Int       @default(0)
  overtimeMinutes   Int       @default(0)
  status            String    @default("present")
  employee          Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([employeeId, attendanceDate])
  @@index([attendanceDate])
}

model Payroll {
  id               String         @id @default(cuid())
  employeeId       String
  salaryId         String
  year             Int
  month            Int
  baseSalary       Float
  overtimeAmount   Float          @default(0)
  bonusAmount      Float          @default(0)
  allowanceAmount  Float          @default(0)
  lateDeduction    Float          @default(0)
  absenceDeduction Float          @default(0)
  otherDeduction   Float          @default(0)
  grossSalary      Float
  totalDeduction   Float
  netSalary        Float
  status           String         @default("draft")
  paidAt           DateTime?
  employee         Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  salary           EmployeeSalary @relation(fields: [salaryId], references: [id], onDelete: Restrict)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([employeeId, year, month])
  @@index([salaryId])
}

model SalaryAdvance {
  id                 String    @id @default(cuid())
  employeeId         String
  amount             Float
  currency           String    @default("IQD")
  requestedAt        DateTime
  approvedAt         DateTime?
  deductionStartDate DateTime?
  installments       Int       @default(1)
  deductedAmount     Float     @default(0)
  remainingAmount    Float
  status             String    @default("requested")
  notes              String?   @db.Text
  employee           Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([employeeId])
  @@index([status])
  @@index([requestedAt])
}

model AccountingAccount {
  id        String              @id @default(cuid())
  code      String              @unique
  name      String
  type      String
  parentId  String?
  currency  String              @default("IQD")
  status    String              @default("active")
  parent    AccountingAccount?  @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  AccountingAccount[] @relation("AccountHierarchy")
  lines     JournalLine[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([type])
  @@index([parentId])
}

model JournalEntry {
  id          String        @id @default(cuid())
  entryNumber String        @unique
  entryDate   DateTime
  description String
  reference   String?
  status      String        @default("draft")
  lines       JournalLine[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([entryDate])
  @@index([status])
}

model JournalLine {
  id          String            @id @default(cuid())
  entryId     String
  accountId   String
  description String?
  debit       Float             @default(0)
  credit      Float             @default(0)
  entry       JournalEntry      @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account     AccountingAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([entryId])
  @@index([accountId])
}

model BillingCustomer {
  id        String           @id @default(cuid())
  code      String           @unique
  name      String
  phone     String?
  email     String?
  address   String?          @db.Text
  taxNumber String?
  status    String           @default("active")
  invoices  BillingInvoice[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model BillingInvoice {
  id             String               @id @default(cuid())
  invoiceNumber  String               @unique
  customerId     String
  issueDate      DateTime
  dueDate        DateTime?
  currency       String               @default("IQD")
  subtotal       Float
  discountAmount Float                @default(0)
  taxAmount      Float                @default(0)
  totalAmount    Float
  paidAmount     Float                @default(0)
  balanceAmount  Float
  status         String               @default("draft")
  notes          String?              @db.Text
  customer       BillingCustomer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items          BillingInvoiceItem[]
  payments       BillingPayment[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([customerId])
  @@index([issueDate])
  @@index([status])
}

model BillingInvoiceItem {
  id          String         @id @default(cuid())
  invoiceId   String
  description String
  quantity    Float
  unitPrice   Float
  discount    Float          @default(0)
  taxRate     Float          @default(0)
  lineTotal   Float
  invoice     BillingInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model BillingPayment {
  id        String         @id @default(cuid())
  invoiceId String
  amount    Float
  method    String
  reference String?
  paidAt    DateTime       @default(now())
  notes     String?
  invoice   BillingInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  createdAt DateTime       @default(now())

  @@index([invoiceId])
  @@index([paidAt])
}

model ServiceAdvance {
  id            String       @id @default(cuid())
  receiptNumber String       @unique
  patientName   String
  patientPhone  String?
  departmentId  String?
  appointmentId String?
  amount        Float
  appliedAmount Float        @default(0)
  balanceAmount Float
  currency      String       @default("IQD")
  method        String
  reference     String?
  receivedAt    DateTime     @default(now())
  status        String       @default("open")
  notes         String?      @db.Text
  department    Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([departmentId])
  @@index([appointmentId])
  @@index([receivedAt])
  @@index([status])
}

model FinanceBudget {
  id            String   @id @default(cuid())
  name          String
  fiscalYear    Int
  department    String?
  category      String
  plannedAmount Float
  currency      String   @default("IQD")
  status        String   @default("draft")
  notes         String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([fiscalYear])
  @@index([status])
}

model FinanceCashFlow {
  id          String   @id @default(cuid())
  flowDate    DateTime
  flowType    String
  category    String
  amount      Float
  currency    String   @default("IQD")
  description String
  status      String   @default("planned")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([flowDate])
  @@index([flowType])
}

model FinanceForecast {
  id               String   @id @default(cuid())
  name             String
  scenario         String   @default("base")
  periodStart      DateTime
  periodEnd        DateTime
  projectedRevenue Float
  projectedExpense Float
  currency         String   @default("IQD")
  status           String   @default("draft")
  notes            String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([periodStart, periodEnd])
  @@index([scenario])
}

model FinanceFunding {
  id              String    @id @default(cuid())
  sourceName      String
  fundingType     String
  committedAmount Float
  receivedAmount  Float     @default(0)
  currency        String    @default("IQD")
  startDate       DateTime
  endDate         DateTime?
  interestRate    Float     @default(0)
  status          String    @default("planned")
  notes           String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([startDate])
}

model ProductCategory {
  id          String             @id @default(cuid())
  name        String             @unique
  description String?
  status      String             @default("active")
  products    InventoryProduct[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model ProductBrand {
  id          String             @id @default(cuid())
  name        String             @unique
  description String?
  status      String             @default("active")
  products    InventoryProduct[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@map("product_brands")
}

model InventoryProduct {
  id            String                  @id @default(cuid())
  sku           String                  @unique
  barcode       String?                 @unique
  name          String
  categoryId    String?
  brandId       String?
  unit          String                  @default("item")
  costPrice     Float
  sellingPrice  Float
  taxRate       Float                   @default(0)
  discountType  String?
  discountValue Float                   @default(0)
  discountStart DateTime?
  discountEnd   DateTime?
  status        String                  @default("active")
  category      ProductCategory?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand         ProductBrand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  stocks        InventoryStock[]
  movements     InventoryMovement[]
  saleItems     PosSaleItem[]
  images        InventoryProductImage[]
  feedback      Feedback[]
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@index([categoryId])
  @@index([brandId])
  @@index([status])
}

model HealthcareService {
  id          String     @id @default(cuid())
  code        String     @unique
  name        String
  description String?    @db.Text
  price       Float?
  status      String     @default("active")
  feedback    Feedback[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status])
}

model Feedback {
  id            String             @id @default(cuid())
  targetType    String
  productId     String?
  serviceId     String?
  customerName  String
  customerEmail String?
  rating        Int
  comment       String             @db.Text
  status        String             @default("pending")
  source        String             @default("website")
  product       InventoryProduct?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  service       HealthcareService? @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([targetType, status])
  @@index([productId])
  @@index([serviceId])
  @@index([createdAt])
}

model InventoryProductImage {
  id        String           @id @default(cuid())
  productId String
  imageUrl  String
  isMain    Boolean          @default(false)
  sortOrder Int              @default(0)
  product   InventoryProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())

  @@index([productId, sortOrder])
  @@map("products_images")
}

model InventoryWarehouse {
  id        String              @id @default(cuid())
  code      String              @unique
  name      String
  location  String?
  status    String              @default("active")
  stocks    InventoryStock[]
  movements InventoryMovement[]
  sales     PosSale[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
}

model InventoryStock {
  id           String             @id @default(cuid())
  productId    String
  warehouseId  String
  quantity     Float              @default(0)
  reorderLevel Float              @default(0)
  product      InventoryProduct   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse    InventoryWarehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId])
  @@index([warehouseId])
}

model InventoryMovement {
  id           String             @id @default(cuid())
  productId    String
  warehouseId  String
  movementType String
  quantity     Float
  reference    String?
  notes        String?
  occurredAt   DateTime           @default(now())
  product      InventoryProduct   @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse    InventoryWarehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@index([occurredAt])
  @@index([productId])
  @@index([warehouseId])
}

model PosSale {
  id             String             @id @default(cuid())
  saleNumber     String             @unique
  warehouseId    String
  customerName   String?
  paymentMethod  String
  subtotal       Float
  discountAmount Float              @default(0)
  taxAmount      Float              @default(0)
  totalAmount    Float
  paidAmount     Float
  changeAmount   Float              @default(0)
  status         String             @default("completed")
  cashierName    String?
  notes          String?
  soldAt         DateTime           @default(now())
  warehouse      InventoryWarehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  items          PosSaleItem[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([soldAt])
  @@index([status])
}

model PosSaleItem {
  id        String           @id @default(cuid())
  saleId    String
  productId String
  quantity  Float
  unitPrice Float
  taxRate   Float            @default(0)
  lineTotal Float
  sale      PosSale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product   InventoryProduct @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([productId])
}
