PORT=4000
DATABASE_URL="mysql://nho_app:nho_app_local_password@127.0.0.1:3306/nho_erp"
MYSQL_ROOT_HOST=127.0.0.1
MYSQL_ROOT_USER=root
MYSQL_ROOT_PASSWORD=your-mysql-root-password
MYSQL_APP_USER=nho_app
MYSQL_APP_PASSWORD=nho_app_local_password
MYSQL_DATABASE=nho_erp
JWT_SECRET="replace-with-a-long-random-secret"
PIN_LOOKUP_SECRET="replace-with-another-long-random-secret"
FRONTEND_URL="http://localhost:3000"
PUBLIC_WEBSITE_URLS="https://example.com,https://www.example.com"
NODE_ENV="development"

# WhatsApp Cloud API (used by the backend CRM integration)
# Choose a verification token and use the same value in Meta's webhook setup.
WHATSAPP_VERIFY_TOKEN=""
# Fill in the access token and phone number ID from Meta.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Matches the default in src/config/environment.js.
WHATSAPP_GRAPH_VERSION="v26.0"

